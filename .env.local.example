# Kiddy local dev. Copy to .env.local
# Data layer defaults to local SQLite (data/kiddy.db) when KIDDY_DATABASE_URL is unset.
KIDDY_DATABASE_URL=file:./data/kiddy.db

# --- Supabase (production platform switch) ---
# When SUPABASE_URL + SUPABASE_ANON_KEY are set, the app uses the Supabase client
# against the schema in supabase/migrations instead of local SQLite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
