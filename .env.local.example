# Kiddy local dev. Copy to .env.local
# Data layer defaults to local SQLite (data/kiddy.db) when KIDDY_DATABASE_URL is unset,
# and switches to real Supabase Postgres when it points at the Supabase pooler.

# --- Data layer ---
# Local SQLite:          KIDDY_DATABASE_URL=file:./data/kiddy.db
# Supabase Postgres:     KIDDY_DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
KIDDY_DATABASE_URL=file:./data/kiddy.db

# --- Supabase (auth + project wiring) ---
# Required for Supabase Auth (GoTrue) + available in the deploy env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public site URL (KID-119) ---
# Parent-facing mail links (invite + auth emails) use this host so parents get
# the deployed URL even when the invite is sent from local dev (localhost).
# Production: set to the deployed URL, e.g. https://kiddy.example.com
# Local dev: leave empty to fall back to the request origin.
NEXT_PUBLIC_SITE_URL=

# --- Wildcard subdomain apex (KID-199.3r) ---
# The apex domain the white-label wildcards live under: every daycare's
# subdomain is <slug>.<PUBLIC_APEX_DOMAIN> (sunshine.daycare.example → the
# Sunshine daycare). Production also needs wildcard DNS *.apex → the host plus
# the wildcard domain on the deployment. Leave empty for single-tenant /
# preview deployments: with no apex, no hostname resolves to a tenant.
PUBLIC_APEX_DOMAIN=

# --- Chatwoot support widget (KID-306) ---
# Client widget mounted in the root layout for web + PWA/TWA builds. Leave
# either value empty to keep the widget off (nothing renders, no request to
# the Chatwoot server). Both values are public client-side by design but must
# live here, never in code. Dev values: the board's local Chatwoot instance.
NEXT_PUBLIC_CHATWOOT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# --- Platform contact inbox (KID-238) ---
# The public contact/demo inbox shown on /contact, in the site footer, and in
# the disabled-daycare message, and the address new inquiries are notified to
# (best-effort, through the existing mail path). Defaults to the board-set
# address when unset.
# PLATFORM_CONTACT_EMAIL=info@kiddyapp.net
