# Kiddy local dev. Copy to .env.local
# Data layer defaults to local SQLite (data/kiddy.db) when KIDDY_DATABASE_URL is unset,
# and switches to real Supabase Postgres when it points at the Supabase pooler.

# --- Data layer ---
# Local SQLite:          KIDDY_DATABASE_URL=file:./data/kiddy.db
# Supabase Postgres:     KIDDY_DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
KIDDY_DATABASE_URL=file:./data/kiddy.db

# --- Supabase (auth + project wiring) ---
# Required for Supabase Auth (GoTrue) + available in the deploy env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public site URL (KID-119) ---
# Parent-facing mail links (invite + auth emails) use this host so parents get
# the deployed URL even when the invite is sent from local dev (localhost).
# Production: set to the deployed URL, e.g. https://kiddy.example.com
# Local dev: leave empty to fall back to the request origin.
NEXT_PUBLIC_SITE_URL=
