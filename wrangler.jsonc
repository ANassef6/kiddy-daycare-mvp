{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "kiddy-web",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kiddy-web"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "731fb486136f4ef7ae512157ca20b766"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "kiddy-web-staging",
      // KID-2495: keep the workers.dev host reachable as a fallback so old
      // links, evidence and tail commands keep working after the custom domain
      // becomes the canonical URL.
      "workers_dev": true,
      // KID-2495: the founder-facing canonical staging host. A Workers custom
      // domain creates the DNS record and certificate on the kiddyapp.net zone
      // and keeps the workers.dev host working as a fallback.
      "routes": [
        {
          "pattern": "staging.kiddyapp.net",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ddcc107a8521433aa4373a67a31d9686"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "kiddy-web-staging"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    }
  }
}
