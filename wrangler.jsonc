{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "kiddy-web",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kiddy-web"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "kiddy-web-staging",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ddcc107a8521433aa4373a67a31d9686"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "kiddy-web-staging"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    }
  }
}
