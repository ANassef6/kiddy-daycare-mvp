{
  "schema": "kiddy.demo-video.scenes.v1",
  "role": "teacher",
  "tenant": "sunshine",
  "baseUrl": "https://sunshine.kiddyapp.net",
  "format": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "voiceover": {
    "en": {
      "locale": "en",
      "dir": "ltr",
      "wordsPerSecond": 2.45
    },
    "ar": {
      "locale": "ar-EG",
      "dir": "rtl",
      "wordsPerSecond": 2.2
    }
  },
  "capture": {
    "storageState": ".auth/teacher.json",
    "reducedMotion": true,
    "minHoldSec": 1.2,
    "settleMs": 900
  },
  "excluded": [
    {
      "route": "/portal/settings",
      "reason": "Admin-only center settings. The page redirects non-admin roles; not a teacher tool."
    },
    {
      "route": "/portal/staff (team list)",
      "reason": "Admin-only team list. A teacher is redirected to their own staff profile, which the video does show."
    },
    {
      "route": "/portal/rooms, /portal/supplies, /portal/report-center, /portal/tags, /portal/forms, /portal/surveys, /portal/performance, /portal/finance",
      "reason": "Admin Tools menu. Hidden from the teacher sidebar and not part of the teacher walkthrough."
    },
    {
      "route": "/portal/children/[id] (Invoices tab) and Manage billing",
      "reason": "The tab renders for teacher accounts but is financial admin data. Excluded from the pilot and reported to the PM/QA for a role-gate decision."
    }
  ],
  "scenes": [
    {
      "id": "01-login",
      "title": "Sign in",
      "tool": "Authentication",
      "route": "/login",
      "auth": false,
      "actions": [
        {
          "op": "goto",
          "path": "/login"
        },
        {
          "op": "waitFor",
          "selector": "form"
        },
        {
          "op": "wait",
          "ms": 600
        },
        {
          "op": "hover",
          "selector": "input[type=email]"
        },
        {
          "op": "hover",
          "selector": "button[type=submit]"
        }
      ],
      "vo": {
        "en": "This is the teacher view of Kiddy. Sign in with the daycare account your manager gave you, and the app opens on your own dashboard.",
        "ar": "دي شاشة المدرس في Kiddy. سجّل دخول بحساب الروضة اللي المدير ادّاه لك، والتطبيق هيفتح على لوحتك."
      }
    },
    {
      "id": "02-dashboard",
      "title": "Dashboard",
      "tool": "Home dashboard",
      "route": "/portal/dashboard",
      "auth": true,
      "actions": [
        {
          "op": "goto",
          "path": "/portal/dashboard"
        },
        {
          "op": "waitFor",
          "selector": "main h1"
        },
        {
          "op": "wait",
          "ms": 500
        },
        {
          "op": "scroll",
          "y": 650
        },
        {
          "op": "scroll",
          "y": 0
        }
      ],
      "vo": {
        "en": "The dashboard is your morning start. It shows the children in your classrooms, who is checked in now, open consents, and the latest reports.",
        "ar": "لوحة التحكم هي بداية يومك. بتوريك الأطفال اللي في فصولك، مين حاضر دلوقتي، الموافقات المفتوحة، وآخر التقارير."
      }
    },
    {
      "id": "03-children",
      "title": "Children",
      "tool": "Child list",
      "route": "/portal/children",
      "auth": true,
      "actions": [
        {
          "op": "goto",
          "path": "/portal/children"
